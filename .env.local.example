# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard > Settings > API). Both values below are safe to expose
# to the browser (that's what NEXT_PUBLIC_ means) — Row Level Security in
# supabase/migrations/0001_init.sql is what actually protects the data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
